{
  "name": "quickcode",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:llm": "bash llm-agent/run.sh",
    "dev:vertex-llm": "bash llm-agent/run.sh",
    "dev:publish-helper": "bash publish-helper/run.sh",
    "dev:with-llm": "concurrently -k -n web,pub,llm -c cyan,green,magenta \"npm run dev\" \"npm run dev:publish-helper\" \"npm run dev:llm\"",
    "rag:reindex": "cd llm-agent && .venv/bin/python scripts/build_rag_index.py",
    "build": "tsc -b && vite build && node scripts/copy-spa-404.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@radix-ui/react-slider": "^1.4.7",
    "@remixicon/react": "^4.9.0",
    "dompurify": "^3.4.14",
    "font-awesome": "^4.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "remixicon": "^4.9.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.1.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
